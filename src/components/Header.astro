---
import { site } from '@/data/site';
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const links = [
  { href: `${baseUrl}about/`, label: 'About' },
  { href: `${baseUrl}journey/`, label: 'Journey' },
  { href: `${baseUrl}work/`, label: 'Selected work' },
  { href: `${baseUrl}insights/`, label: 'Insights' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={baseUrl} aria-label={`${site.name} home`}>
      {site.initials}
      <span>.</span>
    </a>
    <nav aria-label="Main navigation">
      {links.map((link) => (
        <a
          class:list={{
            active:
              Astro.url.pathname.replace(/\/$/, '') ===
              link.href.replace(/\/$/, ''),
          }}
          href={link.href}
        >
          {link.label}
        </a>
      ))}
      <a class="nav-contact" href={`${baseUrl}contact/`}>
        Contact <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
