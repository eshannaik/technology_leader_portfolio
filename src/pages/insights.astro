---
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout title="Insights">
  <section class="page-hero container">
    <p class="eyebrow">INSIGHTS</p>
    <h1>
      Thinking through
      <br />
      <em>the hard problems.</em>
    </h1>
    <p class="hero-intro">
      A growing collection of notes on architecture, data platforms, engineering
      leadership and technology strategy.
    </p>
  </section>
  <section class="section container narrow-copy">
    <div class="empty-state">
      <p class="eyebrow">COMING SOON</p>
      <h2>The first article is taking shape.</h2>
      <p>
        Potential topics include designing multi-tenant data platforms, making
        governance practical, and moving from technical execution to
        architectural leadership.
      </p>
    </div>
  </section>
</SiteLayout>
