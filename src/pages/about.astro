---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { site } from '@/data/site';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<SiteLayout title={`About · ${site.name}`}>
  <section class="page-hero container about-hero">
    <p class="eyebrow">ABOUT {site.name.toUpperCase()}</p>
    <h1>
      I build the systems
      <br />
      <em>behind better decisions.</em>
    </h1>
    <p class="hero-intro">
      I’m a data engineer working across platform architecture, analytics and
      delivery. I like turning complex, messy data problems into systems people
      can trust—and teams can operate.
    </p>
  </section>

  <section class="section container about-story">
    <div class="about-section-heading">
      <p class="eyebrow">THE THROUGH LINE</p>
      <h2>Different industries. A shared engineering challenge.</h2>
      <p>
        My career has moved through transportation, financial reporting and
        credit analytics. In each, the challenge has been bigger than moving
        data: make it dependable, understandable and useful to the people
        making decisions with it.
      </p>
    </div>

    <div class="about-career-cards">
      <article class="about-career-card">
        <p class="about-card-meta">DAIMLER · 2022—2025</p>
        <h3>Make operational data dependable.</h3>
        <p>
          I worked on manufacturing and transportation analytics, supporting
          distributed data platforms, SAP integrations, operational dashboards
          and production reliability.
        </p>
      </article>
      <article class="about-career-card">
        <p class="about-card-meta">SIGMOID · 2025—2026</p>
        <h3>Modernize without losing trust.</h3>
        <p>
          I helped move legacy financial reporting workflows to Azure—migrating
          more than 50 pipelines, improving incremental processing and reducing
          batch failures by about 40%.
        </p>
      </article>
      <article class="about-career-card">
        <p class="about-card-meta">EQUIFAX · 2026—PRESENT</p>
        <h3>Build the platform, not just the pipeline.</h3>
        <p>
          I’m contributing to a metadata-driven Databricks platform processing
          20 million records a day, with reusable data marts, quality controls
          and governed access.
        </p>
      </article>
    </div>
  </section>

  <section class="about-practice">
    <div class="container about-practice-inner">
      <div>
        <p class="eyebrow">HOW I APPROACH THE WORK</p>
        <h2>Good engineering connects the details to the outcome.</h2>
      </div>
      <div class="about-practice-copy">
        <p>
          I start by understanding who needs the data and what decision or
          process it should support. That context shapes the architecture,
          quality checks, access model and operational signals—not the other
          way around.
        </p>
        <p>
          I care about what happens after a system goes live: whether it is
          observable, resilient to change and clear enough for others to own.
          On teams, I value thoughtful technical discussion, explicit
          ownership and sharing context so people can make good decisions
          independently.
        </p>
        <p>
          I’ve owned technical delivery across implementation phases and
          mentored developers, while staying hands-on with the engineering
          work. I enjoy that balance between solving a difficult technical
          problem and helping a team move forward together.
        </p>
      </div>
    </div>
  </section>

  <section class="section container about-learning">
    <div class="about-learning-copy">
      <p class="eyebrow">STAYING CURIOUS</p>
      <h2>Learning is part of the work.</h2>
      <p>
        I completed ISB’s Advanced Management Programme in Business Analytics
        and AI while working—first at Sigmoid, then at Equifax. It gave me
        another lens on how analytical methods connect to business decisions.
      </p>
      <p>
        My capstone explored thermal-imaging computer vision for industrial
        ladle monitoring, bringing together AI concepts and a practical
        manufacturing problem.
      </p>
      <a class="text-link" href={`${baseUrl}journey/`}>
        Explore my career journey and education <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="about-beyond">
    <div class="container about-beyond-inner">
      <div class="about-beyond-heading">
        <p class="eyebrow">BEYOND WORK</p>
        <h2>A few things that keep me curious.</h2>
        <p>
          Work is one part of what I’m interested in. I also make time for
          subjects that help me see the world from a different angle.
        </p>
      </div>

      <div class="about-interest-grid">
        <article class="about-interest-card">
          <span class="about-interest-number">01</span>
          <h3>History</h3>
          <p>
            I enjoy looking at how people, ideas and events shape one another
            over time—and how the past helps explain the present.
          </p>
        </article>
        <article class="about-interest-card">
          <span class="about-interest-number">02</span>
          <h3>Cosmology</h3>
          <p>
            Questions about the scale and origins of the universe are a
            welcome reminder of how much there is still to understand.
          </p>
        </article>
        <article class="about-interest-card">
          <span class="about-interest-number">03</span>
          <h3>Fitness</h3>
          <p>
            Training gives me a practical way to build consistency, stay
            energized and make progress one session at a time.
          </p>
        </article>
        <article class="about-interest-card">
          <span class="about-interest-number">04</span>
          <h3>Games &amp; markets</h3>
          <p>
            I like the mix of strategy, systems and decision-making in video
            games and financial markets.
          </p>
        </article>
      </div>

      <div class="about-quote-row" aria-label="Personal reminders">
        <blockquote>
          <span>“</span>
          The ironic tragedy is that life has to be lived forward but only
          makes sense in reverse.
        </blockquote>
        <blockquote>
          <span>“</span>
          I was scared to turn the page, until I realised I’m the author.
        </blockquote>
      </div>
    </div>
  </section>
</SiteLayout>
