---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { site } from '@/data/site';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<SiteLayout title={`About · ${site.name}`}>
  <section class="page-hero container">
    <p class="eyebrow">ABOUT</p>
    <h1>
      Technology with context.
      <br />
      <em>Leadership with intent.</em>
    </h1>
    <p class="hero-intro">
      A professional profile focused on the intersection of business priorities,
      architecture and engineering execution.
    </p>
  </section>
  <section class="section container narrow-copy">
    <h2>My perspective</h2>
    <p>
      I'm naturally curious and enjoy exploring ideas, challenging myself and
      understanding how things work. That curiosity spans technology, business,
      science, history and finance—and helps me connect perspectives beyond my
      immediate field.
    </p>
    <p>
      Professionally, I'm drawn to complex problems, meaningful outcomes and
      taking ideas from conception to execution. I believe growth comes from
      building depth while staying open to new perspectives and continuous
      learning.
    </p>

    <h2>Leadership principles</h2>
    <ul>
      <li>Start with the business outcome.</li>
      <li>Design for reliability, security and change.</li>
      <li>Make complexity understandable.</li>
      <li>Enable people through clarity, ownership and mentorship.</li>
    </ul>

    <h2>Beyond work</h2>
    <p>
      Outside my professional life, I enjoy history, cosmology, fitness, video
      games, and following financial markets and investing. Each offers a
      different perspective and something new to learn.
    </p>
    <a class="text-link" href={`${baseUrl}journey/`}>
      Explore my career journey and education <span aria-hidden="true">→</span>
    </a>
  </section>
</SiteLayout>
